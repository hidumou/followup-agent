{
  "name": "followup-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "mastra dev",
    "dev:ui": "node --env-file-if-exists=.env src/runtime/server.ts --dev",
    "start": "node --env-file-if-exists=.env src/runtime/server.ts",
    "build": "vite build",
    "job:daily": "node --env-file-if-exists=.env src/cli/daily.ts",
    "schedule:tick": "node --env-file-if-exists=.env src/cli/schedule-tick.ts",
    "schedule:install": "node --env-file-if-exists=.env src/cli/schedule.ts install",
    "schedule:status": "node --env-file-if-exists=.env src/cli/schedule.ts status",
    "schedule:uninstall": "node --env-file-if-exists=.env src/cli/schedule.ts uninstall",
    "approve": "node --env-file-if-exists=.env src/cli/approve.ts",
    "db:migrate": "node --env-file-if-exists=.env src/cli/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ai": "node --env-file-if-exists=.env src/cli/test-ai.ts",
    "test:ai:tools": "node --env-file-if-exists=.env src/cli/test-ai-tools.ts",
    "console": "node --env-file-if-exists=.env src/console/server/index.ts",
    "console:dev": "node --env-file-if-exists=.env src/console/server/index.ts --dev",
    "console:build": "vite build",
    "status": "node --env-file-if-exists=.env src/cli/console-query.ts status",
    "followups": "node --env-file-if-exists=.env src/cli/console-query.ts followups",
    "runs": "node --env-file-if-exists=.env src/cli/console-query.ts runs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.18",
    "@libsql/client": "^0.18.0",
    "@mastra/core": "^1.82.0",
    "@mastra/libsql": "^1.29.0",
    "diff": "^9.0.0",
    "hono": "^4.13.17",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mastra": "^1.38.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
