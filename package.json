{
  "name": "followup-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "mastra dev",
    "dev:ui": "node --env-file-if-exists=.env src/runtime/server.ts --dev",
    "start": "node --env-file-if-exists=.env src/runtime/server.ts",
    "build": "vite build",
    "job:daily": "node --env-file-if-exists=.env src/cli/daily.ts",
    "approve": "node --env-file-if-exists=.env src/cli/approve.ts",
    "db:migrate": "node --env-file-if-exists=.env src/cli/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@mastra/core": "^1.82.0",
    "@mastra/libsql": "^1.29.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mastra": "^1.38.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
