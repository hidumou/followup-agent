  "components": {
    "schemas": {
      "Limits": {
        "type": "object",
        "properties": {
          "maxUsers": {
            "type": "integer",
            "minimum": 0
          },
          "maxCalls": {
            "type": "integer",
            "minimum": 0
          },
          "dailyTokens": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "maxUsers",
          "maxCalls",
          "dailyTokens"
        ]
      },
      "Usage": {
        "type": "object",
        "properties": {
          "modelCalls": {
            "type": "integer",
            "minimum": 0
          },
          "llmCalls": {
            "type": "integer",
            "minimum": 0
          },
          "inputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "modelCalls",
          "llmCalls",
          "inputTokens",
          "outputTokens"
        ]
      },
      "Label": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "feature": {
            "type": "string"
          },
          "lessThan": {
            "type": "number"
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "subject",
          "body"
        ]
      },
      "Playbook": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "allowedFeatures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Label"
            }
          },
          "rules": {
            "type": "object",
            "properties": {
              "minLength": {
                "type": "integer",
                "minimum": 0
              },
              "maxLength": {
                "type": "integer",
                "minimum": 0
              },
              "requiredText": {
                "type": "string"
              },
              "forbiddenPhrases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "minLength",
              "maxLength",
              "requiredText",
              "forbiddenPhrases"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "goal",
          "allowedFeatures",
          "labels",
          "rules"
        ]
      },
      "Run": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "waiting_approval",
              "completed",
              "failed",
              "cancelled",
              "interrupted"
            ]
          },
          "step": {
            "type": "string",
            "enum": [
              "discover",
              "context",
              "classify",
              "draft",
              "guard",
              "review",
              "send",
              "done"
            ]
          },
          "playbook": {
            "$ref": "#/components/schemas/Playbook"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ownerPid": {
            "type": [
              "integer",
              "null"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "workflowRunId": {
            "type": "string"
          },
          "userIds": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "processed": {
            "type": "integer",
            "minimum": 0
          },
          "skipped": {
            "type": "integer",
            "minimum": 0
          },
          "currentUserId": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "cancelRequested": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "status",
          "step",
          "playbook",
          "limits",
          "usage",
          "createdAt",
          "updatedAt",
          "ownerPid",
          "attempt",
          "workflowRunId",
          "userIds",
          "processed",
          "skipped",
          "cancelRequested"
        ]
      },
      "Draft": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "labelName": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "originalSubject": {
            "type": "string"
          },
          "originalBody": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_approval",
              "approved",
              "rejected",
              "simulated"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
